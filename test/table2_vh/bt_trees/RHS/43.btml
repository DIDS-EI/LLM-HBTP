selector
    cond IsClean(candle)
    sequence
        cond IsHoldingCleaningTool(self)
        selector
            sequence
                cond IsNear(self,candle)
                act Wipe(candle)
            sequence
                cond IsStanding(self)
                act Walk(candle)
    sequence
        cond IsStanding(self)
        cond IsRightHandEmpty(self)
        selector
            sequence
                cond IsNear(self,rag)
                act RightGrab(rag)
            act Walk(rag)
