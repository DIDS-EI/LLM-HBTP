selector
    sequence
        cond IsPlugged(fridge)
        cond IsCut(cutlets)
    sequence
        cond IsPlugged(fridge)
        selector
            selector
                sequence
                    cond IsLeftHolding(self,cutlets)
                    selector
                        selector
                            sequence
                                cond IsHoldingKnife(self)
                                act Cut(cutlets)
                            sequence
                                cond IsRightHandEmpty(self)
                                cond IsNear(self,kitchenknife)
                                act RightGrab(kitchenknife)
                        sequence
                            cond IsStanding(self)
                            cond IsRightHandEmpty(self)
                            act Walk(kitchenknife)
                sequence
                    cond IsNear(self,cutlets)
                    cond IsStanding(self)
                    cond IsLeftHandEmpty(self)
                    cond IsRightHandEmpty(self)
                    act LeftGrab(cutlets)
            sequence
                cond IsStanding(self)
                cond IsLeftHandEmpty(self)
                cond IsRightHandEmpty(self)
                act Walk(cutlets)
    sequence
        cond IsStanding(self)
        cond IsUnplugged(fridge)
        cond IsLeftHandEmpty(self)
        cond IsRightHandEmpty(self)
        selector
            sequence
                cond IsNear(self,fridge)
                act PlugIn(fridge)
            act Walk(fridge)
