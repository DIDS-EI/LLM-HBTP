selector
    sequence
        cond IsSwitchedOn(candle)
        cond IsOpen(fridge)
    sequence
        cond IsSwitchedOff(fridge)
        cond IsLeftHandEmpty(self)
        cond IsClose(fridge)
        selector
            selector
                sequence
                    cond IsSwitchedOn(candle)
                    selector
                        sequence
                            cond IsNear(self,fridge)
                            act Open(fridge)
                        sequence
                            cond IsStanding(self)
                            act Walk(fridge)
                sequence
                    cond IsStanding(self)
                    cond IsNear(self,candle)
                    cond IsSwitchedOff(candle)
                    act SwitchOn(candle)
            sequence
                cond IsStanding(self)
                cond IsSwitchedOff(candle)
                act Walk(candle)
