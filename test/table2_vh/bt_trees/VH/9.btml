selector
    sequence
        cond IsOn(waterglass,desk)
        cond IsOn(breadslice,desk)
        cond IsOn(book,desk)
    sequence
        cond IsOn(breadslice,desk)
        selector
            selector
                selector
                    selector
                        sequence
                            cond IsOn(book,desk)
                            selector
                                selector
                                    sequence
                                        cond IsRightHolding(self,waterglass)
                                        selector
                                            sequence
                                                cond IsNear(self,desk)
                                                act RightPut(waterglass,desk)
                                            sequence
                                                cond IsStanding(self)
                                                act Walk(desk)
                                    sequence
                                        cond IsNear(self,waterglass)
                                        cond IsRightHandEmpty(self)
                                        cond IsStanding(self)
                                        act RightGrab(waterglass)
                                sequence
                                    cond IsRightHandEmpty(self)
                                    cond IsStanding(self)
                                    act Walk(waterglass)
                        sequence
                            cond IsRightHolding(self,book)
                            cond IsNear(self,desk)
                            cond IsStanding(self)
                            act RightPut(book,desk)
                    sequence
                        cond IsRightHolding(self,book)
                        cond IsStanding(self)
                        act Walk(desk)
                sequence
                    cond IsNear(self,book)
                    cond IsRightHandEmpty(self)
                    cond IsStanding(self)
                    act RightGrab(book)
            sequence
                cond IsRightHandEmpty(self)
                cond IsStanding(self)
                act Walk(book)
    sequence
        cond IsStanding(self)
        selector
            selector
                sequence
                    cond IsRightHolding(self,breadslice)
                    selector
                        sequence
                            cond IsNear(self,desk)
                            act RightPut(breadslice,desk)
                        act Walk(desk)
                sequence
                    cond IsNear(self,breadslice)
                    cond IsRightHandEmpty(self)
                    act RightGrab(breadslice)
            sequence
                cond IsRightHandEmpty(self)
                act Walk(breadslice)
