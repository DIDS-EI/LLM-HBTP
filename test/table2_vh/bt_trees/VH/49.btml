selector
    cond IsOn(waterglass,nightstand)
    sequence
        cond IsRightHolding(self,waterglass)
        selector
            sequence
                cond IsNear(self,nightstand)
                act RightPut(waterglass,nightstand)
            sequence
                cond IsStanding(self)
                act Walk(nightstand)
    sequence
        cond IsRightHandEmpty(self)
        cond IsStanding(self)
        selector
            sequence
                cond IsNear(self,waterglass)
                act RightGrab(waterglass)
            act Walk(waterglass)
