        cond IsIn(milk,fridge)
        cond IsIn(juice,fridge)
    sequence
        cond IsLeftHandEmpty(self)
        selector
            selector
                selector
                    selector
                        sequence
                            cond IsOpen(fridge)
                            selector
                                sequence
                                    cond IsIn(milk,fridge)
                                    selector
                                        selector
                                            selector
                                                sequence
