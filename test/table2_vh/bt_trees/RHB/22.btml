selector
    sequence
        cond IsClose(fridge)
        cond IsIn(chicken,fridge)
        cond IsIn(peach,fridge)
    sequence
        cond IsLeftHandEmpty(self)
        selector
            selector
                selector
                    selector
                        sequence
                            cond IsOpen(fridge)
                            selector
                                selector
                                    sequence
                                        cond IsIn(peach,fridge)
                                        selector
                                            selector
                                                selector
                                                    sequence
                                                        cond IsNear(self,fridge)
                                                        selector
                                                            sequence
                                                                cond IsIn(chicken,fridge)
                                                                act Close(fridge)
                                                            sequence
                                                                cond IsRightHolding(self,chicken)
                                                                cond IsPlugged(fridge)
                                                                act RightPutIn(chicken,fridge)
                                                    sequence
                                                        cond IsRightHolding(self,chicken)
                                                        cond IsStanding(self)
                                                        cond IsPlugged(fridge)
                                                        act Walk(fridge)
                                                sequence
                                                    cond IsRightHandEmpty(self)
                                                    cond IsStanding(self)
                                                    cond IsPlugged(fridge)
                                                    cond IsNear(self,chicken)
                                                    act RightGrab(chicken)
                                            sequence
                                                cond IsRightHandEmpty(self)
                                                cond IsStanding(self)
                                                cond IsPlugged(fridge)
                                                act Walk(chicken)
                                    sequence
                                        cond IsNear(self,fridge)
                                        cond IsRightHolding(self,peach)
                                        cond IsStanding(self)
                                        cond IsPlugged(fridge)
                                        act RightPutIn(peach,fridge)
                                sequence
                                    cond IsUnplugged(fridge)
                                    cond IsRightHolding(self,peach)
                                    cond IsNear(self,fridge)
                                    cond IsStanding(self)
                                    act PlugIn(fridge)
                        sequence
                            cond IsUnplugged(fridge)
                            cond IsSwitchedOff(fridge)
                            cond IsClose(fridge)
                            cond IsNear(self,fridge)
                            cond IsRightHolding(self,peach)
                            cond IsStanding(self)
                            act Open(fridge)
                    sequence
                        cond IsUnplugged(fridge)
                        cond IsSwitchedOff(fridge)
                        cond IsClose(fridge)
                        cond IsRightHolding(self,peach)
                        cond IsStanding(self)
                        act Walk(fridge)
                sequence
                    cond IsUnplugged(fridge)
                    cond IsSwitchedOff(fridge)
                    cond IsClose(fridge)
                    cond IsNear(self,peach)
                    cond IsRightHandEmpty(self)
                    cond IsStanding(self)
                    act RightGrab(peach)
            sequence
                cond IsUnplugged(fridge)
                cond IsSwitchedOff(fridge)
                cond IsClose(fridge)
                cond IsRightHandEmpty(self)
                cond IsStanding(self)
                act Walk(peach)
