selector
    sequence
        cond IsIn(clothespants,clothespile)
        cond IsClose(clothespile)
        cond IsIn(clothesshirt,clothespile)
    sequence
        cond IsLeftHandEmpty(self)
        selector
            selector
                selector
                    selector
                        sequence
                            cond IsOpen(clothespile)
                            selector
                                sequence
                                    cond IsIn(clothesshirt,clothespile)
                                    selector
                                        selector
                                            selector
                                                sequence
