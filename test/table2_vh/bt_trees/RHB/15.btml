selector
    cond IsClean(window)
    sequence
        cond IsHoldingCleaningTool(self)
        selector
            sequence
                cond IsNear(self,window)
                act Wipe(window)
            sequence
                cond IsStanding(self)
                act Walk(window)
    sequence
        cond IsRightHandEmpty(self)
        cond IsStanding(self)
        selector
            sequence
                cond IsNear(self,rag)
                act RightGrab(rag)
            act Walk(rag)
