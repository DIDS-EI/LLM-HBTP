selector
    sequence
        cond IsOn(cupcake,kitchentable)
        cond IsOn(chicken,kitchentable)
    sequence
        cond IsOn(chicken,kitchentable)
        selector
            selector
                sequence
                    cond IsRightHolding(self,cupcake)
                    selector
                        sequence
                            cond IsNear(self,kitchentable)
                            act RightPut(cupcake,kitchentable)
                        sequence
                            cond IsStanding(self)
                            act Walk(kitchentable)
                sequence
                    cond IsNear(self,cupcake)
                    cond IsRightHandEmpty(self)
                    cond IsStanding(self)
                    act RightGrab(cupcake)
            sequence
                cond IsRightHandEmpty(self)
                cond IsStanding(self)
                act Walk(cupcake)
    sequence
        cond IsStanding(self)
        selector
            selector
                sequence
                    cond IsRightHolding(self,chicken)
                    selector
                        sequence
                            cond IsNear(self,kitchentable)
                            act RightPut(chicken,kitchentable)
                        act Walk(kitchentable)
                sequence
                    cond IsRightHandEmpty(self)
                    cond IsNear(self,chicken)
                    act RightGrab(chicken)
            sequence
                cond IsRightHandEmpty(self)
                act Walk(chicken)
