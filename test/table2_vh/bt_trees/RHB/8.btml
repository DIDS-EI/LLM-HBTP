selector
    sequence
        cond IsIn(milk,fridge)
        cond IsIn(breadslice,fridge)
        cond IsIn(chicken,fridge)
    sequence
        cond IsOpen(fridge)
        selector
            sequence
                cond IsPlugged(fridge)
                selector
                    sequence
                        cond IsIn(chicken,fridge)
                        selector
                            selector
                                selector
                                    selector
                                        sequence
                                            cond IsIn(milk,fridge)
                                            selector
                                                selector
                                                    sequence
                                                        cond IsRightHolding(self,breadslice)
                                                        selector
                                                            sequence
                                                                cond IsNear(self,fridge)
                                                                act RightPutIn(breadslice,fridge)
                                                            sequence
                                                                cond IsStanding(self)
                                                                act Walk(fridge)
                                                    sequence
                                                        cond IsNear(self,breadslice)
                                                        cond IsRightHandEmpty(self)
                                                        cond IsStanding(self)
                                                        act RightGrab(breadslice)
                                                sequence
                                                    cond IsRightHandEmpty(self)
                                                    cond IsStanding(self)
                                                    act Walk(breadslice)
                                        sequence
                                            cond IsNear(self,fridge)
                                            cond IsStanding(self)
                                            cond IsRightHolding(self,milk)
                                            act RightPutIn(milk,fridge)
                                    sequence
                                        cond IsStanding(self)
                                        cond IsRightHolding(self,milk)
                                        act Walk(fridge)
                                sequence
                                    cond IsNear(self,milk)
                                    cond IsRightHandEmpty(self)
                                    cond IsStanding(self)
                                    act RightGrab(milk)
                            sequence
                                cond IsRightHandEmpty(self)
                                cond IsStanding(self)
                                act Walk(milk)
                    sequence
                        cond IsNear(self,fridge)
                        cond IsRightHolding(self,chicken)
                        cond IsStanding(self)
                        act RightPutIn(chicken,fridge)
            sequence
                cond IsUnplugged(fridge)
                cond IsLeftHandEmpty(self)
                cond IsNear(self,fridge)
                cond IsRightHolding(self,chicken)
                cond IsStanding(self)
                act PlugIn(fridge)
    sequence
        cond IsUnplugged(fridge)
        cond IsSwitchedOff(fridge)
        cond IsClose(fridge)
        cond IsLeftHandEmpty(self)
        cond IsStanding(self)
        selector
            selector
                sequence
                    cond IsRightHolding(self,chicken)
                    selector
                        sequence
                            cond IsNear(self,fridge)
                            act Open(fridge)
                        act Walk(fridge)
                sequence
                    cond IsRightHandEmpty(self)
                    cond IsNear(self,chicken)
                    act RightGrab(chicken)
            sequence
                cond IsRightHandEmpty(self)
                act Walk(chicken)
