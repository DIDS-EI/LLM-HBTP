selector
    sequence
        cond IsSwitchedOn(microwave)
        cond IsIn(cutlets,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        cond IsLeftHandEmpty(self)
        selector
            selector
                selector
                    sequence
                        cond IsNear(self,microwave)
                        selector
                            selector
                                sequence
                                    cond IsPlugged(microwave)
                                    selector
                                        sequence
                                            cond IsIn(cutlets,microwave)
                                            selector
                                                sequence
                                                    cond IsClose(microwave)
                                                    act SwitchOn(microwave)
                                                sequence
                                                    cond IsOpen(microwave)
                                                    act Close(microwave)
                                        sequence
                                            cond IsRightHolding(self,cutlets)
                                            cond IsOpen(microwave)
                                            act RightPutIn(cutlets,microwave)
                                sequence
                                    cond IsRightHolding(self,cutlets)
                                    cond IsOpen(microwave)
                                    cond IsUnplugged(microwave)
                                    act PlugIn(microwave)
                            sequence
                                cond IsRightHolding(self,cutlets)
                                cond IsClose(microwave)
                                cond IsUnplugged(microwave)
                                act Open(microwave)
                    sequence
                        cond IsRightHolding(self,cutlets)
                        cond IsStanding(self)
                        cond IsClose(microwave)
                        cond IsUnplugged(microwave)
                        act Walk(microwave)
                sequence
                    cond IsNear(self,cutlets)
                    cond IsClose(microwave)
                    cond IsRightHandEmpty(self)
                    cond IsStanding(self)
                    cond IsUnplugged(microwave)
                    act RightGrab(cutlets)
            sequence
                cond IsStanding(self)
                cond IsRightHandEmpty(self)
                cond IsClose(microwave)
                cond IsUnplugged(microwave)
                act Walk(cutlets)
