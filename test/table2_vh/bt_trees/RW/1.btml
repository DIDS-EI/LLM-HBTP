selector
    cond On(Water,Table1)
    sequence
        cond Holding(Water)
        selector
            sequence
                cond RobotNear(Table1)
                act PutDown(Water,Table1)
            act MoveTo(Table1)
    sequence
        cond Holding(Nothing)
        selector
            selector
                sequence
                    cond RobotNear(Water)
                    act PickUp(Water)
                sequence
                    cond Exists(Water)
                    act MoveTo(Water)
            act Make(Water)
