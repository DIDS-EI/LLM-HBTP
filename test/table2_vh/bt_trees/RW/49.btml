selector
    cond On(VacuumCup,Table2)
    sequence
        cond Holding(VacuumCup)
        selector
            sequence
                cond RobotNear(Table2)
                act PutDown(VacuumCup,Table2)
            act MoveTo(Table2)
    sequence
        cond Holding(Nothing)
        selector
            sequence
                cond RobotNear(VacuumCup)
                act PickUp(VacuumCup)
            sequence
                cond Exists(VacuumCup)
                act MoveTo(VacuumCup)
