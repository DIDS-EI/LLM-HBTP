selector
    cond On(Softdrink,Table3)
    sequence
        cond Holding(Softdrink)
        selector
            sequence
                cond RobotNear(Table3)
                act PutDown(Softdrink,Table3)
            act MoveTo(Table3)
    sequence
        cond Holding(Nothing)
        selector
            sequence
                cond RobotNear(Softdrink)
                act PickUp(Softdrink)
            sequence
                cond Exists(Softdrink)
                act MoveTo(Softdrink)
